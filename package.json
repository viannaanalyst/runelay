{
  "name": "runelay",
  "version": "0.6.8",
  "homepage": "https://runelay.com",
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun --filter @runelay/api --filter @runelay/web dev",
    "start": "bun --filter @runelay/api start",
    "import": "bun --filter @runelay/cli import",
    "install-clients": "bun --filter @runelay/cli install-clients",
    "import-context": "bun --filter @runelay/cli import-context",
    "sync-context": "bun --filter @runelay/cli sync-context",
    "seed": "bun --filter @runelay/api seed",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter @runelay/web build",
    "build:cli": "bun apps/cli/build.ts",
    "test": "bun --filter '*' test"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
