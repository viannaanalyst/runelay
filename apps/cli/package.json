{
  "name": "@runelay/cli",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "bin": {
    "runelay": "src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "import": "bun src/index.ts import",
    "install-clients": "bun src/index.ts connect",
    "import-context": "bun src/index.ts push",
    "sync-context": "bun src/index.ts pull",
    "test": "bun test"
  },
  "dependencies": {
    "@runelay/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}
